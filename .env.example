# Lead delivery (Phase 1). Required in production — the build refuses to start
# without them. See src/lib/env.ts.

DATABASE_URL=
RESEND_API_KEY=

# Serverless state (Phase A). Required in production. Same contract as the
# database and email: missing values refuse the boot.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides
RESEND_FROM="bpulse <intake@bpulse.dev>"
FOUNDER_EMAIL=contact@bpulse.dev
