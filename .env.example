# Lead delivery (Phase 1). Required in production — the build refuses to start
# without them. See src/lib/env.ts.

DATABASE_URL=
RESEND_API_KEY=

# Serverless state (Phase A). Required in production. Same contract as the
# database and email: missing values refuse the boot.

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional overrides
RESEND_FROM="bpulse <intake@bpulse.dev>"
FOUNDER_EMAIL=contact@bpulse.dev

# Studio admin auth
STUDIO_AUTH_SECRET=
STUDIO_ADMIN_ALLOWLIST=

# Public analytics (self-hosted Umami)
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Portal analytics (PostHog, authenticated portal only)
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_POSTHOG_KEY=

# Supabase portal data
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
